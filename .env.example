PORT=4173
DATAPILOT_SUPABASE_URL=https://your-project.supabase.co
DATAPILOT_SUPABASE_ANON_KEY=replace-with-your-anon-key
DATAPILOT_API_BASE_URL=https://schemaai-delta.vercel.app/api

# AI Provider Configuration
# Priority: Ollama (local) → Groq → Gemini

# Ollama (Recommended - Local, Unlimited, Free)
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# Groq (Fast API - Free Tier)
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (Backup Option)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
